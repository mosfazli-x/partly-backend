generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  CUSTOMER
  VENDOR
  ADMIN
}

enum UserStatus {
  ACTIVE
  PENDING
  SUSPENDED
}

enum ProductStatus {
  ACTIVE
  PENDING
  REJECTED
}

enum OrderStatus {
  PENDING
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
}

enum PaymentMethod {
  COD
}

model User {
  id           String     @id @default(cuid())
  name         String
  email        String     @unique
  passwordHash String
  role         Role       @default(CUSTOMER)
  status       UserStatus @default(ACTIVE)
  shopName     String?
  phone        String?
  address      String?
  sessions     Session[]
  products     Product[]
  orders       Order[]
  soldItems    OrderItem[] @relation("VendorItems")
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
}

model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())
  @@index([userId])
  @@index([expiresAt])
}

model Order {
  id            String        @id @default(cuid())
  userId        String
  user          User          @relation(fields: [userId], references: [id])
  status        OrderStatus   @default(PENDING)
  paymentMethod PaymentMethod @default(COD)
  total         Decimal       @db.Decimal(16, 2)
  name          String
  phone         String
  address       String
  postalCode    String
  note          String?
  items         OrderItem[]
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  @@index([userId, createdAt])
}

model OrderItem {
  id          String      @id @default(cuid())
  orderId     String
  order       Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId   String
  product     Product     @relation(fields: [productId], references: [id], onDelete: Restrict)
  vendorId    String?
  vendor      User?       @relation("VendorItems", fields: [vendorId], references: [id], onDelete: SetNull)
  name        String
  sku         String
  image       String
  price       Decimal     @db.Decimal(12, 2)
  quantity    Int
  status      OrderStatus @default(PENDING)
  @@index([orderId])
  @@index([vendorId, status])
}

enum VehicleType {
  CAR
  MOTORCYCLE
  TRUCK
}

enum VehicleBody {
  SEDAN
  HATCHBACK
  CROSSOVER
  SUV
  PICKUP
  FASTBACK
  VAN
  COUPE
  SCOOTER
  MAXI_SCOOTER
  ADVENTURE_SCOOTER
  UNDERBONE
  NAKED
  STANDARD
  SPORT
  TRAIL
  MINI
  SCRAMBLER
  ADVENTURE
  NEO_RETRO
  CLASSIC
  CRUISER
  TOURING
  OTHER
}

enum VehicleFuel {
  GASOLINE
  DIESEL
  HYBRID
  ELECTRIC
  CNG
  OTHER
}

enum MarketStatus {
  CURRENT
  LEGACY
  IMPORTED
  ASSEMBLED
  OTHER
}

enum ProductCondition {
  NEW
  REFURBISHED
  USED
}

model VehicleMake {
  id           String        @id @default(cuid())
  name         String
  slug         String        @unique
  type         VehicleType
  logo         String?
  faName       String?
  enName       String?
  manufacturer String?
  sourceGroup  String?
  models       VehicleModel[]
  createdAt    DateTime      @default(now())
  @@unique([name, type])
}

model VehicleModel {
  id           String           @id @default(cuid())
  makeId       String
  name         String
  slug         String
  yearFrom     Int?
  yearTo       Int?
  faName       String?
  enName       String?
  manufacturer String?
  body         VehicleBody?
  marketStatus MarketStatus?
  sourceGroup  String?
  make         VehicleMake      @relation(fields: [makeId], references: [id], onDelete: Cascade)
  variants     VehicleVariant[]
  createdAt    DateTime         @default(now())
  @@unique([makeId, slug])
  @@index([makeId])
}

model VehicleVariant {
  id             String        @id @default(cuid())
  modelId        String
  name           String
  slug           String
  engine         String?
  years          String?
  faName         String?
  enName         String?
  body           VehicleBody?
  displacementCc Int?
  transmission   String?
  drive          String?
  fuel           VehicleFuel?
  marketStatus   MarketStatus?
  sourceGroup    String?
  model          VehicleModel  @relation(fields: [modelId], references: [id], onDelete: Cascade)
  fitments       ProductFitment[]
  createdAt      DateTime      @default(now())
  @@unique([modelId, slug])
  @@index([modelId])
}

model Category {
  id          String             @id @default(cuid())
  parentId    String?
  name        String
  slug        String            @unique
  description String?
  icon        String?
  sortOrder   Int               @default(0)
  parent      Category?         @relation("CategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children    Category[]        @relation("CategoryTree")
  products    Product[]
  createdAt   DateTime          @default(now())
  @@index([parentId])
}

model Product {
  id            String          @id @default(cuid())
  sku           String          @unique
  name          String
  slug          String          @unique
  description   String
  price         Decimal         @db.Decimal(12, 2)
  compareAt     Decimal?        @db.Decimal(12, 2)
  stock         Int             @default(0)
  condition     ProductCondition @default(NEW)
  brand         String
  image         String
  tags          String[]
  vendorId      String?
  vendor        User?           @relation(fields: [vendorId], references: [id], onDelete: SetNull)
  status        ProductStatus   @default(ACTIVE)
  orderItems    OrderItem[]
  categoryId    String
  category      Category        @relation(fields: [categoryId], references: [id])
  fitments      ProductFitment[]
  specifications ProductSpecification[]
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  @@index([categoryId])
  @@index([brand])
  @@index([vendorId, status])
  @@index([status, createdAt])
}

model ProductFitment {
  productId String
  variantId String
  product   Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant   VehicleVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  @@id([productId, variantId])
  @@index([variantId])
}

model ProductSpecification {
  id        String  @id @default(cuid())
  productId String
  name      String
  value     String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  @@index([productId])
}
